// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
  dayLogs   DayLog[]
  emailSuggestions EmailSuggestion[]
  oAuthConfigs OAuthConfig[]
  tags      Tag[]
  projects  Project[]
  habits    Habit[]
}

model Task {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  notes       String   @default("")
  category    String   @default("work")   // work | personal | errands | calls | reading
  priority    String   @default("medium") // urgent | high | medium | low
  status      String   @default("pending") // pending | done | cancelled
  dueDatetime DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Recurrence
  isRecurring    Boolean  @default(false)
  recurrenceRule String   @default("")

  // Source tracking
  source       String @default("manual") // manual | email | ai
  sourceEmailId String @default("")

  // AI priority score (computed, cached)
  aiScore Float @default(0)

  // Kanban board column
  boardColumn String  @default("todo") // todo | in_progress | review | done

  // Project relation
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  dayLogs DayLogTask[]
  tags    TagTask[]
}

model DayLog {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             String   // YYYY-MM-DD format
  summary          String   @default("")
  totalTasks       Int      @default(0)
  completedTasks   Int      @default(0)
  productivityScore Float   @default(0)

  tasks DayLogTask[]

  @@unique([userId, date])
}

model DayLogTask {
  id       String @id @default(cuid())
  dayLogId String
  dayLog   DayLog @relation(fields: [dayLogId], references: [id], onDelete: Cascade)
  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([dayLogId, taskId])
}

model EmailSuggestion {
  id               String  @id @default(cuid())
  userId           String
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailId          String  @unique
  sender           String
  subject          String
  actionDetected   String
  suggestedTitle   String
  suggestedPriority String @default("medium")
  confirmed        Boolean? // null=pending, true=accepted, false=rejected
  createdAt        DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════
// Google OAuth2 Token Storage — Single-user model
// Stores access_token, refresh_token, and metadata for the
// system user so Gmail/Calendar API calls can be made server-side.
// ═══════════════════════════════════════════════════════════════
model OAuthConfig {
  id           String   @id @default(cuid())
  userId       String   @unique  // Links to the single system user
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   @default("google")  // OAuth provider name (future-proof)
  accessToken  String   // Encrypted in production; plain for dev
  refreshToken String   // Required for offline access
  expiryDate   DateTime? // When the access_token expires
  scopes       String   @default("") // Comma-separated granted scopes
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#7aa2f7")
  createdAt DateTime @default(now())
  tasks     TagTask[]

  @@unique([userId, name])
}

model TagTask {
  id     String @id @default(cuid())
  tagId  String
  tag    Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)
  taskId String
  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([tagId, taskId])
}

// ═══════════════════════════════════════════════════════════════
// Projects — Group tasks by project
// ═══════════════════════════════════════════════════════════════
model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  color       String   @default("#7aa2f7")
  icon        String   @default("📁")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]

  @@unique([userId, name])
}

// ═══════════════════════════════════════════════════════════════
// Habits — Daily habit tracking with streaks
// ═══════════════════════════════════════════════════════════════
model Habit {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String     @default("")
  icon        String     @default("✅")
  color       String     @default("#9ece6a")
  frequency   String     @default("daily") // daily | weekly | custom
  targetCount Int        @default(1)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  logs        HabitLog[]
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  count     Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([habitId, date])
}
