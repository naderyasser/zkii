// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
  dayLogs   DayLog[]
  emailSuggestions EmailSuggestion[]
  oAuthConfigs OAuthConfig[]
  tags      Tag[]
  projects  Project[]
  habits    Habit[]
}

// @deprecated منذ المرحلة 6 — اتنقلت لـ Page/Database/Row (قاعدة «المهام»).
// مُحتفَظ بها للأدوات القديمة (/legacy) وللـ rollback. متمسحهاش.
model Task {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  notes       String   @default("")
  category    String   @default("work")   // work | personal | errands | calls | reading
  priority    String   @default("medium") // urgent | high | medium | low
  status      String   @default("pending") // pending | done | cancelled
  dueDatetime DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Recurrence
  isRecurring    Boolean  @default(false)
  recurrenceRule String   @default("")

  // Source tracking
  source       String @default("manual") // manual | email | ai
  sourceEmailId String @default("")

  // AI priority score (computed, cached)
  aiScore Float @default(0)

  // Kanban board column
  boardColumn String  @default("todo") // todo | in_progress | review | done

  // Project relation
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  dayLogs DayLogTask[]
  tags    TagTask[]
}

model DayLog {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             String   // YYYY-MM-DD format
  summary          String   @default("")
  totalTasks       Int      @default(0)
  completedTasks   Int      @default(0)
  productivityScore Float   @default(0)

  tasks DayLogTask[]

  @@unique([userId, date])
}

model DayLogTask {
  id       String @id @default(cuid())
  dayLogId String
  dayLog   DayLog @relation(fields: [dayLogId], references: [id], onDelete: Cascade)
  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([dayLogId, taskId])
}

model EmailSuggestion {
  id               String  @id @default(cuid())
  userId           String
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailId          String  @unique
  sender           String
  subject          String
  actionDetected   String
  suggestedTitle   String
  suggestedPriority String @default("medium")
  confirmed        Boolean? // null=pending, true=accepted, false=rejected
  createdAt        DateTime @default(now())

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════
// Google OAuth2 Token Storage — Single-user model
// Stores access_token, refresh_token, and metadata for the
// system user so Gmail/Calendar API calls can be made server-side.
// ═══════════════════════════════════════════════════════════════
model OAuthConfig {
  id           String   @id @default(cuid())
  userId       String   @unique  // Links to the single system user
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   @default("google")  // OAuth provider name (future-proof)
  accessToken  String   // Encrypted in production; plain for dev
  refreshToken String   // Required for offline access
  expiryDate   DateTime? // When the access_token expires
  scopes       String   @default("") // Comma-separated granted scopes
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#7aa2f7")
  createdAt DateTime @default(now())
  tasks     TagTask[]

  @@unique([userId, name])
}

model TagTask {
  id     String @id @default(cuid())
  tagId  String
  tag    Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)
  taskId String
  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([tagId, taskId])
}

// ═══════════════════════════════════════════════════════════════
// Projects — Group tasks by project
// ═══════════════════════════════════════════════════════════════
// @deprecated منذ المرحلة 6 — اتنقلت لقاعدة «المشاريع» (Page/Database/Row). متمسحهاش.
model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  color       String   @default("#7aa2f7")
  icon        String   @default("📁")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]

  @@unique([userId, name])
}

// ═══════════════════════════════════════════════════════════════
// Habits — Daily habit tracking with streaks
// ═══════════════════════════════════════════════════════════════
// @deprecated منذ المرحلة 6 — اتنقلت لقاعدة «العادات» (Page/Database/Row). متمسحهاش.
model Habit {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String     @default("")
  icon        String     @default("✅")
  color       String     @default("#9ece6a")
  frequency   String     @default("daily") // daily | weekly | custom
  targetCount Int        @default(1)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  logs        HabitLog[]

  @@index([userId])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  count     Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([habitId, date])
}

// ═══════════════════════════════════════════════════════════════════════════════
// NOTION-LIKE WORKSPACE — Page / Database / Row  (المرحلة 2)
// الجداول القديمة (Task/Project/Habit...) بتفضل موجودة؛ النقل بيحصل في المرحلة 6.
// ═══════════════════════════════════════════════════════════════════════════════

model Page {
  id         String    @id @default(cuid())
  title      String    @default("بدون عنوان")
  icon       String? // emoji أو "lucide:Name"
  coverUrl   String?
  coverMeta  String? // JSON: {title,artist,year,source} لغلاف Met
  palette    String? // JSON: {accentLight,accentDark,tint,swatches[]} مستخرج من الغلاف
  parentId   String?
  parent     Page?     @relation("PageTree", fields: [parentId], references: [id])
  children   Page[]    @relation("PageTree")
  type       String    @default("page") // page | database
  content    String? // BlockNote JSON (string في SQLite)
  position   Float     @default(0)
  isFavorite Boolean   @default(false)
  archivedAt DateTime? // soft delete = سلة المهملات
  userId     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  database   Database?

  @@index([parentId])
  @@index([userId])
}

model Database {
  id         String @id @default(cuid())
  pageId     String @unique
  page       Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId     String? // عزل المستخدم (backfill من الصفحة الأم)
  properties String // JSON: [{id,name,type,options}] — types: text,number,select,multiSelect,date,checkbox,url,relation
  views      String // JSON: [{id,name,type:'table'|'kanban'|'calendar'|'list',filters,sorts,groupBy}]
  rows       Row[]

  @@index([userId])
}

model Row {
  id         String   @id @default(cuid())
  databaseId String
  database   Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  userId     String? // عزل المستخدم (backfill من database→page)
  properties String // JSON: {propId: value}
  pageId     String? // كل row ممكن يفتح كصفحة كاملة
  position   Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([databaseId])
  @@index([userId])
}
