# ═══════════════════════════════════════════════════════════════════════════════
# مثال على متغيّرات البيئة — انسخ هذا الملف إلى .env واملأ القيم
#   cp .env.example .env
# ممنوع وضع أي secret هنا — كل المفاتيح تُترك فارغة وتُملأ في .env فقط
# ═══════════════════════════════════════════════════════════════════════════════

# ─── AI Provider الأساسي (محلي عبر Ollama — OpenAI-compatible) ─────────────────
# مجاني، self-hosted، localhost فقط. ثبّت Ollama وشغّل: ollama pull qwen3:4b-instruct
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen3:4b-instruct

# ─── AI Provider احتياطي (اختياري — يُستخدم تلقائياً لو المحلي فشل/timeout) ──────
# اتركه فارغاً (AI_FALLBACK_API_KEY=) للتشغيل المحلي بالكامل بدون أي API خارجي
AI_FALLBACK_BASE_URL=https://inference-api.nousresearch.com/v1
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=Hermes-4-405B

# ─── Web Search (اختياري — Tavily أو Serper) ──────────────────────────────────
# لو فاضي، البحث يرجّع "البحث غير مفعّل" بدون كسر التطبيق
SEARCH_API_KEY=
SEARCH_PROVIDER=tavily

# ─── Database ─────────────────────────────────────────────────────────────────
# المسار نسبي لمجلد الـ schema (prisma/) → فبيشير لـ db/ في جذر المشروع
DATABASE_URL=file:../db/custom.db

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://zakii.educore.software

# ─── NextAuth + Google OAuth (اختياري) ────────────────────────────────────────
NEXTAUTH_URL=https://zakii.educore.software
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# في Google Cloud Console أضف نفس الـ redirect URI:
GOOGLE_REDIRECT_URI=https://zakii.educore.software/api/auth/google/callback

# ─── Optional features (معطّلة افتراضياً) ─────────────────────────────────────
# التحويل الصوتي (ASR) — لإظهار زر المايك اضبطها true + وفّر مزوّد ASR خارجي
NEXT_PUBLIC_ENABLE_ASR=false
ASR_API_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
# توليد الصور (Motivation) — وفّر مزوّد صور خارجي متوافق مع OpenAI
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
